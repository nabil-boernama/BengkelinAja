PORT=3000
# Transaksi MongoDB (Anggota 2) butuh replica set. Pakai Atlas, atau lokal: mongod --replSet rs0
MONGODB_URI=mongodb://127.0.0.1:27017/laju_jaya?replicaSet=rs0
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=8h

# Password awal akun seeding (khusus development)
SEED_ADMIN_PASSWORD=admin123
SEED_MEKANIK_PASSWORD=mekanik123
SEED_OWNER_PASSWORD=owner123
